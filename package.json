{
  "name": "lemscape",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"studio/**/*.test.ts\" \"plugins/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "vendor:baskstream": "bash scripts/vendor-baskstream-sdk.sh",
    "sim": "node scripts/sim-station.mjs",
    "symbols:build": "node scripts/build-symbols.mjs",
    "symbols:sync": "node scripts/build-symbols.mjs --from ../../symbol-library/svg"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@basidekick/baskstream": "file:vendor/baskstream-sdk",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@msgpack/msgpack": "^3.1.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "mammoth": "1.13.0",
    "mssql": "^12.7.9",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.14.1",
    "read-excel-file": "9.3.10",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tldraw": "^5.4.2",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
